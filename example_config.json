{
  "model_list": [
    {
      "model_name": "gpt-4o-mini",
      "model": "openai/gpt-4o-mini",
      "api_base": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}"
    },
    {
      "model_name": "claude-sonnet-4.6",
      "model": "anthropic/claude-sonnet-4.6",
      "api_base": "https://api.anthropic.com/v1",
      "api_key": "${ANTHROPIC_API_KEY}"
    },
    {
      "model_name": "gemini-pro",
      "model": "gemini/gemini-2.0-flash",
      "api_base": "https://generativelanguage.googleapis.com/v1beta",
      "api_key": "${GOOGLE_API_KEY}"
    },
    {
      "model_name": "ollama-llama3",
      "model": "ollama/llama3",
      "api_base": "http://localhost:11434/v1",
      "api_key": "ollama"
    }
  ],
  "agents": {
    "defaults": {
      "model": "gpt-4o-mini",
      "workspace": "~/.picoclaw/workspace",
      "max_tokens": 8192,
      "max_tool_iterations": 35,
      "send_progress": true,
      "send_tool_hints": false,
      "restrict_to_workspace": true,
      "compaction": {
        "reserve_tokens": 16384,
        "keep_recent_tokens": 20000,
        "reserve_tokens_floor": 20000,
        "memory_flush": {
          "enabled": true,
          "soft_threshold_tokens": 4000
        }
      }
    }
  },
  "tools": {
    "web": {
      "brave": {
        "enabled": false,
        "api_key": "${BRAVE_API_KEY}",
        "max_results": 5
      },
      "tavily": {
        "enabled": false,
        "api_key": "${TAVILY_API_KEY}",
        "max_results": 5
      },
      "duckduckgo": {
        "enabled": true,
        "max_results": 5
      },
      "perplexity": {
        "enabled": false,
        "api_key": "${PERPLEXITY_API_KEY}",
        "max_results": 5
      }
    },
    "exec": {
      "enabled": true,
      "enable_deny_patterns": true
    },
    "browser": {
      "enabled": false,
      "cdp_url": "ws://localhost:9222"
    },
    "skills": {
      "registries": {
        "clawhub": {
          "enabled": true,
          "base_url": "https://clawhub.ai"
        }
      },
      "max_concurrent_searches": 2,
      "search_cache": {
        "max_size": 50,
        "ttl_seconds": 300
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "bridge_url": "ws://localhost:3001",
      "allow_from": []
    },
    "telegram": {
      "enabled": false,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allow_from": []
    },
    "feishu": {
      "enabled": false,
      "app_id": "${FEISHU_APP_ID}",
      "app_secret": "${FEISHU_APP_SECRET}",
      "encrypt_key": "${FEISHU_ENCRYPT_KEY}",
      "verification_token": "${FEISHU_VERIFICATION_TOKEN}",
      "allow_from": []
    },
    "discord": {
      "enabled": false,
      "token": "${DISCORD_BOT_TOKEN}",
      "allow_from": [],
      "mention_only": false
    },
    "maixcam": {
      "enabled": false,
      "host": "0.0.0.0",
      "port": 18790,
      "allow_from": []
    },
    "qq": {
      "enabled": false,
      "app_id": "${QQ_APP_ID}",
      "app_secret": "${QQ_APP_SECRET}",
      "allow_from": []
    },
    "dingtalk": {
      "enabled": false,
      "client_id": "${DINGTALK_CLIENT_ID}",
      "client_secret": "${DINGTALK_CLIENT_SECRET}",
      "allow_from": []
    },
    "slack": {
      "enabled": false,
      "bot_token": "${SLACK_BOT_TOKEN}",
      "app_token": "${SLACK_APP_TOKEN}",
      "allow_from": []
    },
    "line": {
      "enabled": false,
      "channel_secret": "${LINE_CHANNEL_SECRET}",
      "channel_access_token": "${LINE_CHANNEL_ACCESS_TOKEN}",
      "webhook_host": "0.0.0.0",
      "webhook_port": 18791,
      "webhook_path": "/webhook/line",
      "allow_from": []
    },
    "onebot": {
      "enabled": false,
      "ws_url": "ws://127.0.0.1:3001",
      "access_token": "${ONEBOT_ACCESS_TOKEN}",
      "reconnect_interval": 5,
      "group_trigger_prefix": [],
      "allow_from": []
    },
    "wecom": {
      "enabled": false,
      "token": "${WECOM_TOKEN}",
      "encoding_aes_key": "${WECOM_ENCODING_AES_KEY}",
      "webhook_url": "${WECOM_WEBHOOK_URL}",
      "webhook_host": "0.0.0.0",
      "webhook_port": 18793,
      "webhook_path": "/webhook/wecom",
      "allow_from": [],
      "reply_timeout": 5
    },
    "wecom_app": {
      "enabled": false,
      "corp_id": "${WECOM_APP_CORP_ID}",
      "corp_secret": "${WECOM_APP_CORP_SECRET}",
      "agent_id": 0,
      "token": "${WECOM_APP_TOKEN}",
      "encoding_aes_key": "${WECOM_APP_ENCODING_AES_KEY}",
      "webhook_host": "0.0.0.0",
      "webhook_port": 18792,
      "webhook_path": "/webhook/wecom-app",
      "allow_from": [],
      "reply_timeout": 5
    }
  },
  "providers": {
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "api_base": "https://api.openai.com/v1",
      "web_search": true
    }
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790
  },
  "heartbeat": {
    "enabled": true,
    "interval": 30
  },
  "devices": {
    "enabled": false,
    "monitor_usb": true
  },
  "memory": {
    "enabled": true,
    "db_path": "~/.picoclaw/memory.db",
    "retention_days": 30,
    "auto_compact": true
  }
}